# Run node scripts/setup.mjs to generate random local secrets automatically.
# Required PostgreSQL credentials. Never use this placeholder as a real password.
POSTGRES_PASSWORD=
# Required for local Node process. In Compose host is overridden to db.
DATABASE_URL=postgresql://clnup:REPLACE_WITH_GENERATED_PASSWORD@localhost:5432/clnup
# Required: at least 48 characters generated using a cryptographic RNG.
SESSION_SECRET=
# Exact browser origin, used for CSRF. Production must use https://.
APP_ORIGIN=http://localhost:3000
PORT=3000
# development: HTTP cookie; production: Secure cookie + HTTPS required.
NODE_ENV=development
UPLOAD_DIR=./uploads
# 1 only behind exactly one trusted reverse proxy; otherwise 0.
TRUST_PROXY=0
# Optional HTTPS tile template. Default uses OpenStreetMap public tiles (no key).
# Set empty to disable online tiles. Custom providers may require a public token.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
