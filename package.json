{
 "name": "clnup-server",
 "version": "1.0.0",
 "private": true,
 "type": "module",
 "engines": {
  "node": ">=22.12 <25"
 },
 "scripts": {
  "dev": "tsx watch src/index.ts",
  "build": "tsc",
  "start": "node dist/index.js",
  "db:generate": "prisma generate",
  "db:migrate": "prisma migrate deploy",
  "db:seed": "node --import tsx scripts/seed.ts",
  "admin:create": "node --import tsx scripts/admin.ts",
  "test": "node --import tsx --test --test-concurrency=1 tests/integration.test.ts",
  "setup": "node scripts/setup.mjs",
  "test:docker": "node scripts/test-compose.mjs"
 },
 "dependencies": {
  "@prisma/client": "6.19.3",
  "argon2": "0.44.0",
  "connect-pg-simple": "10.0.0",
  "dotenv": "17.2.3",
  "express": "5.1.0",
  "express-session": "1.18.2",
  "helmet": "8.1.0",
  "leaflet": "1.9.4",
  "multer": "2.4.0",
  "pg": "8.16.3",
  "sharp": "0.35.5",
  "zod": "3.25.76"
 },
 "devDependencies": {
  "@types/connect-pg-simple": "7.0.3",
  "@types/express": "5.0.3",
  "@types/express-session": "1.18.2",
  "@types/multer": "2.0.0",
  "@types/node": "24.7.2",
  "@types/pg": "8.15.5",
  "@types/supertest": "6.0.3",
  "prisma": "6.19.3",
  "supertest": "7.1.4",
  "tsx": "4.20.6",
  "typescript": "5.9.3"
 },
 "overrides": {
  "effect": "3.20.0",
  "deepmerge-ts": "8.0.0"
 }
}
